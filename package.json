{
  "name": "next-cms-starter",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "next start --port 3001",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:triple-h": "node scripts/seed-triple-h.mjs",
    "seed:news": "node scripts/seed-news.mjs",
    "seed:triple-h-pages": "node scripts/seed-triple-h-pages.mjs",
    "seed:site-copy": "node scripts/seed-site-copy.mjs",
    "seed:seo": "node scripts/seed-seo.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "seed:testimonials": "node scripts/seed-testimonials.mjs",
    "seed:accreditations": "node scripts/seed-accreditations.mjs",
    "remove:video-post-type": "node scripts/remove-video-post-type.mjs",
    "seed:legal": "node scripts/seed-legal-pages.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.{json,mjs}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"*.{json,mjs}\" \"tests/**/*.js\"",
    "typecheck": "tsc --project jsconfig.typecheck.json",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "botid": "^1.5.11",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.9",
    "mongoose": "^9.9.3",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.8",
    "react-select": "^5.10.2",
    "sanitize-html": "2.17.7",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.3.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
